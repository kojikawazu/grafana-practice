# ---- PostgreSQL ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=tasks

# ---- task-app: DB 接続（pg 標準環境変数） ----
PGHOST=postgres
PGPORT=5432
PGUSER=app
PGPASSWORD=app_password
PGDATABASE=tasks

# ---- task-app: OpenTelemetry ----
OTEL_SERVICE_NAME=task-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---- Grafana 管理者 ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
